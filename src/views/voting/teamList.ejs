<%- include('../partials/header') %>

<h1 class="h3 mb-1">Voto di gradimento</h1>
<p class="text-muted">Scegli fino a 5 giocatori per ciascuna delle altre squadre (max 2 per ruolo, 1 portiere).</p>

<div class="row g-3 mb-5">
  <% myProgress.forEach(({ team, selectedCount }) => { %>
    <div class="col-sm-6 col-lg-4">
      <a href="/voting/<%= team.id %>" class="text-decoration-none">
        <div class="card h-100 team-card <%= selectedCount > 0 ? 'team-card-started' : '' %>">
          <div class="card-body d-flex justify-content-between align-items-center">
            <span class="fw-semibold"><%= team.name %></span>
            <span class="badge <%= selectedCount === 5 ? 'text-bg-success' : selectedCount > 0 ? 'text-bg-warning' : 'text-bg-light border' %>">
              <%= selectedCount %>/5
            </span>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<h2 class="h5 mb-3">Avanzamento generale della lega</h2>
<p class="text-muted small">Chi ha già votato tutte le rose e chi è ancora indietro (non mostra le scelte, solo lo stato).</p>
<div class="table-responsive">
  <table class="table table-sm align-middle bg-white">
    <thead>
      <tr>
        <th>Squadra</th>
        <th>Avanzamento</th>
        <th>Squadre ancora da votare</th>
      </tr>
    </thead>
    <tbody>
      <% overallProgress.forEach(p => { %>
        <tr>
          <td class="fw-semibold"><%= p.teamName %></td>
          <td>
            <span class="badge <%= p.doneCount === p.totalTargets ? 'text-bg-success' : 'text-bg-secondary' %>">
              <%= p.doneCount %>/<%= p.totalTargets %>
            </span>
          </td>
          <td class="text-muted small">
            <%= p.missing.length ? p.missing.join(', ') : '— completato —' %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
