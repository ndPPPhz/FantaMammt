<%- include('../partials/header') %>

<h1 class="h3 mb-1">Classifica</h1>
<p class="text-muted">
  Classifica di partenza dalla stagione precedente e crediti iniziali per l'asta.
  <code>Punteggio classifica = 0.8 &times; Posizione scontri diretti + 0.2 &times; Posizione miglior punteggio</code>
</p>

<p class="text-muted small">
  Budget totale asta = Crediti inizio stagione + Crediti residui anno scorso.
</p>

<% if (!showBudget) { %>
  <div class="alert alert-secondary">
    I crediti residui per l'asta (budget totale meno costo riconferme) saranno visibili qui quando le riconferme saranno chiuse per l'intera lega.
  </div>
<% } %>

<div class="table-responsive">
  <table class="table table-sm table-hover align-middle bg-white">
    <thead>
      <tr>
        <th>Pos.</th>
        <th>Squadra</th>
        <th>Scontri diretti</th>
        <th>Miglior punteggio</th>
        <th>Punteggio classifica</th>
        <th>Crediti residui anno scorso</th>
        <th>Crediti inizio stagione</th>
        <th>Budget totale asta</th>
        <% if (showBudget) { %>
          <th>Costo riconferme</th>
          <th>Crediti residui asta</th>
        <% } %>
      </tr>
    </thead>
    <tbody>
      <% standings.forEach(s => { %>
        <tr>
          <td class="fw-semibold"><%= s.posizioneClassifica %></td>
          <td class="fw-semibold"><%= s.name %></td>
          <td><%= s.posizioneScontriDiretti %></td>
          <td>
            <%= s.posizioneMigliorPunteggio %>
            <% if (s.exEquoMigliorPunteggio) { %>
              <span class="badge text-bg-light border">ex-equo</span>
            <% } %>
          </td>
          <td><%= s.punteggioClassifica %></td>
          <td><%= s.creditiResiduiAnnoScorso %></td>
          <td><%= s.creditiInizioStagione %></td>
          <td class="fw-semibold"><%= s.budgetTotaleAsta %></td>
          <% if (showBudget) { %>
            <td><%= s.costoRiconferme %></td>
            <td class="fw-semibold"><%= s.creditiResiduiAsta %></td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
