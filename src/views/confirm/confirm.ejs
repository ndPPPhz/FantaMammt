<%- include('../partials/header') %>

<h1 class="h3 mb-1">Riconferme</h1>
<p class="text-muted">Scegli fino a 5 giocatori della tua rosa da confermare per la nuova stagione (max 2 per ruolo, 1 portiere).</p>

<% if (waiting) { %>
  <div class="alert alert-secondary">
    La fase di riconferma non è ancora aperta. Sarà disponibile dopo la chiusura del voto di gradimento.
  </div>
<% } else { %>

  <% if (readOnly) { %>
    <div class="alert alert-success">
      Le riconferme sono chiuse: questa è la tua selezione finale, costo totale
      <strong><%= totalCost %></strong>.
    </div>
  <% } %>

  <form action="/confirm" method="post">
    <div class="alert alert-light border d-flex justify-content-between align-items-center sticky-top selection-bar">
      <span>
        Selezionati: <strong id="selectedCount"><%= selectedIds.size %></strong>/5
        &middot; costo totale: <strong id="totalCost">0</strong>
      </span>
      <% if (!readOnly) { %>
        <button class="btn btn-primary" type="submit">Salva riconferme</button>
      <% } %>
    </div>

    <% ['P','D','C','A'].forEach(role => { %>
      <% const rolePlayers = players.filter(p => p.ruolo === role); %>
      <% if (rolePlayers.length) { %>
        <div class="card mb-3">
          <div class="card-header fw-semibold">
            <%= { P: 'Portieri', D: 'Difensori', C: 'Centrocampisti', A: 'Attaccanti' }[role] %>
          </div>
          <div class="list-group list-group-flush">
            <% rolePlayers.forEach(player => { %>
              <%- include('../partials/playerCheckboxRow', {
                player,
                checked: selectedIds.has(player.id),
                showCost: true,
                disabled: readOnly,
              }) %>
            <% }) %>
          </div>
        </div>
      <% } %>
    <% }) %>
  </form>

  <script>
    (function () {
      const form = document.querySelector('form');
      if (!form) return;
      const counter = document.getElementById('selectedCount');
      const totalEl = document.getElementById('totalCost');
      const maxPerRole = { P: 1, D: 2, C: 2, A: 2 };

      function refresh() {
        const checked = [...form.querySelectorAll('input[type=checkbox]:checked')];
        counter.textContent = checked.length;
        totalEl.textContent = checked.reduce((sum, c) => sum + Number(c.dataset.cost || 0), 0);

        const countByRole = { P: 0, D: 0, C: 0, A: 0 };
        checked.forEach((c) => countByRole[c.dataset.role]++);

        form.querySelectorAll('input[type=checkbox]').forEach((c) => {
          if (c.checked) return;
          const roleFull = countByRole[c.dataset.role] >= maxPerRole[c.dataset.role];
          const totalFull = checked.length >= 5;
          c.disabled = <%= readOnly ? 'true' : 'roleFull || totalFull' %>;
          c.closest('.player-row').classList.toggle('player-row-disabled', c.disabled);
        });
      }

      form.addEventListener('change', (e) => {
        if (e.target.checked) e.target.closest('.player-row').classList.add('player-row-checked');
        else e.target.closest('.player-row').classList.remove('player-row-checked');
        refresh();
      });
      refresh();
    })();
  </script>
<% } %>

<%- include('../partials/footer') %>
