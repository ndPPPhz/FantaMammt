<%- include('../partials/header') %>

<h1 class="h3 mb-1">Voti ricevuti</h1>

<% if (waiting) { %>
  <div class="alert alert-secondary">
    I voti saranno visibili a tutti solo quando anche le riconferme saranno chiuse per l'intera lega.
  </div>
<% } else { %>
<p class="text-muted">I voti sono pubblici: per ogni giocatore vedi quante squadre lo hanno votato e quali.</p>

<div class="table-responsive">
  <table class="table table-sm table-hover align-middle bg-white">
    <thead>
      <tr>
        <th></th>
        <th>Giocatore</th>
        <th>Squadra reale</th>
        <th>Fantasquadra</th>
        <th>Costo prec.</th>
        <th>Voti</th>
        <th>Votato da</th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(({ player, count, voterNames }) => { %>
        <tr>
          <td><%- include('../partials/roleBadge', { ruolo: player.ruolo }) %></td>
          <td class="fw-semibold"><%= player.nome %></td>
          <td class="text-muted"><%= player.squadra %></td>
          <td class="text-muted"><%= player.team_name %></td>
          <td><%= player.costo_precedente %></td>
          <td>
            <span class="badge <%= count > 0 ? 'text-bg-primary' : 'text-bg-light border' %>"><%= count %></span>
          </td>
          <td class="text-muted small"><%= voterNames.join(', ') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<%- include('../partials/footer') %>
