<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 mb-3 text-center">Accesso amministratore</h1>
        <form action="/admin/login" method="post">
          <div class="mb-3">
            <label class="form-label" for="password">Password</label>
            <input class="form-control" type="password" id="password" name="password" required autofocus>
          </div>
          <button class="btn btn-dark w-100" type="submit">Entra</button>
        </form>
        <p class="text-center text-muted small mt-3 mb-0">
          <a href="/login">&larr; Torna al login squadra</a>
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
